# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudflare D1 ───────────────────────────────────────────────────────────
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# ─── Upstash Redis (rate limiting — shared across serverless instances) ───────
# Required in production / any environment with more than one instance.
# Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_BUCKET_NAME=
CF_R2_ENDPOINT=
CF_R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Shared secret that gates /api/email — set to a long random string in production.
# emailService.ts passes this in x-email-internal-secret header automatically.
EMAIL_INTERNAL_SECRET=

# ─── App URL (required for server-to-server email dispatch) ──────────────────
NEXT_PUBLIC_APP_URL=https://homverax.com

# ─── Payment Providers (optional) ────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
